# GEMINI_API_KEY: Required for Gemini AI API calls (Google AI Studio).
# Get your key from: https://aistudio.google.com/app/apikey
# NEVER commit a real key to this file — add it to your .env file (which is gitignored).
GEMINI_API_KEY="GEMINI_API_KEY"

# ENVIRONMENT: Set to "production" to disable Swagger docs and tighten security
ENVIRONMENT="development"

# ALLOWED_ORIGINS: Comma-separated list of allowed CORS origins
# Example for production: "https://nmihp.yourdomain.gov.in"
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"
=======
# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
