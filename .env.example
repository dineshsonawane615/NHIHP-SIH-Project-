# GEMINI_API_KEY: Required for Gemini AI API calls (Google AI Studio).
# Get your key from: https://aistudio.google.com/app/apikey
# NEVER commit a real key to this file — add it to your .env file (which is gitignored).
GEMINI_API_KEY="your-gemini-api-key-here"

# ENVIRONMENT: Set to "production" to disable Swagger docs and tighten security.
ENVIRONMENT="development"

# ALLOWED_ORIGINS: Comma-separated list of allowed CORS origins.
# Example for production: "https://nmihp.yourdomain.gov.in"
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# JWT_SECRET_KEY: Secret key for JWT token signing.
# MUST be changed to a strong random secret in production.
JWT_SECRET_KEY="NMIHP-SIH-SECRET-CHANGE-IN-PRODUCTION"

# VITE_AUTH_TOKEN: Bearer token used by the React frontend to authenticate with the backend.
# In development this defaults to "NMIHP-DEV-TOKEN-2026" (set in api.ts).
# In production, set this to a valid JWT issued by your auth system.
VITE_AUTH_TOKEN="NMIHP-DEV-TOKEN-2026"
